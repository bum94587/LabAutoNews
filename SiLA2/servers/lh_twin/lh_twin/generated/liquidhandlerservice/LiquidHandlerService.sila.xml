<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="liquidhandling" FeatureVersion="1.0" MaturityLevel="Draft" Originator="org.labautonews" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>LiquidHandlerService</Identifier>
  <DisplayName>Liquid Handler Service</DisplayName>
  <Description>Column-wise (8-channel) liquid handling on a Hamilton STAR digital twin: PyLabRobot's v1 STAR firmware-level simulator plus its resource and volume model.</Description>
  <Command>
    <Identifier>Initialize</Identifier>
    <DisplayName>Initialize</DisplayName>
    <Description>Set up the STAR twin: run firmware discovery and initialisation against the simulator and load the POC deck layout.</Description>
    <Observable>No</Observable>
    <Response>
      <Identifier>Summary</Identifier>
      <DisplayName>Summary</DisplayName>
      <Description>Instrument and deck summary</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
  </Command>
  <Command>
    <Identifier>GetDeckLayout</Identifier>
    <DisplayName>Get Deck Layout</DisplayName>
    <Description>Return the deck as JSON: carriers, plates, tip racks and their locations.</Description>
    <Observable>No</Observable>
    <Response>
      <Identifier>DeckLayoutJson</Identifier>
      <DisplayName>Deck Layout JSON</DisplayName>
      <Description>Deck tree as JSON</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>PickUpTips</Identifier>
    <DisplayName>Pick Up Tips</DisplayName>
    <Description>Pick up 8 tips from one column of a tip rack.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>TipRack</Identifier>
      <DisplayName>Tip Rack</DisplayName>
      <Description>Tip rack resource name</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Column</Identifier>
      <DisplayName>Column</DisplayName>
      <Description>Column number, 1-12</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Message</Identifier>
      <DisplayName>Message</DisplayName>
      <Description>Human-readable summary of what the digital twin did</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
      <Identifier>LiquidHandlingError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Aspirate</Identifier>
    <DisplayName>Aspirate</DisplayName>
    <Description>Aspirate the same volume with 8 channels from one plate column.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Plate</Identifier>
      <DisplayName>Plate</DisplayName>
      <Description>Plate resource name</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Column</Identifier>
      <DisplayName>Column</DisplayName>
      <Description>Column number, 1-12</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>VolumeUl</Identifier>
      <DisplayName>Volume (uL)</DisplayName>
      <Description>Volume per channel in microlitres</Description>
      <DataType>
        <Basic>Real</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Message</Identifier>
      <DisplayName>Message</DisplayName>
      <Description>Human-readable summary of what the digital twin did</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
      <Identifier>LiquidHandlingError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Dispense</Identifier>
    <DisplayName>Dispense</DisplayName>
    <Description>Dispense the same volume with 8 channels into one plate column.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Plate</Identifier>
      <DisplayName>Plate</DisplayName>
      <Description>Plate resource name</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Column</Identifier>
      <DisplayName>Column</DisplayName>
      <Description>Column number, 1-12</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>VolumeUl</Identifier>
      <DisplayName>Volume (uL)</DisplayName>
      <Description>Volume per channel in microlitres</Description>
      <DataType>
        <Basic>Real</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Message</Identifier>
      <DisplayName>Message</DisplayName>
      <Description>Human-readable summary of what the digital twin did</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
      <Identifier>LiquidHandlingError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>DropTips</Identifier>
    <DisplayName>Drop Tips</DisplayName>
    <Description>Return the mounted tips to the spots they came from.</Description>
    <Observable>No</Observable>
    <Response>
      <Identifier>Message</Identifier>
      <DisplayName>Message</DisplayName>
      <Description>Human-readable summary of what the digital twin did</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
      <Identifier>LiquidHandlingError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Transfer</Identifier>
    <DisplayName>Transfer</DisplayName>
    <Description>Pick up fresh tips, aspirate from a source column, dispense into a target column, drop tips. Observable: reports each step.</Description>
    <Observable>Yes</Observable>
    <Parameter>
      <Identifier>SourcePlate</Identifier>
      <DisplayName>Source Plate</DisplayName>
      <Description>Source plate name</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>SourceColumn</Identifier>
      <DisplayName>Source Column</DisplayName>
      <Description>1-12</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>TargetPlate</Identifier>
      <DisplayName>Target Plate</DisplayName>
      <Description>Target plate name</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>TargetColumn</Identifier>
      <DisplayName>Target Column</DisplayName>
      <Description>1-12</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>VolumeUl</Identifier>
      <DisplayName>Volume (uL)</DisplayName>
      <Description>Volume per channel in microlitres</Description>
      <DataType>
        <Basic>Real</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Message</Identifier>
      <DisplayName>Message</DisplayName>
      <Description>Human-readable summary of what the digital twin did</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <IntermediateResponse>
      <Identifier>Step</Identifier>
      <DisplayName>Step</DisplayName>
      <Description>The sub-step now running</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </IntermediateResponse>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
      <Identifier>LiquidHandlingError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>GetWellVolumes</Identifier>
    <DisplayName>Get Well Volumes</DisplayName>
    <Description>Return the twin's tracked volume (uL) of every well of a plate, as JSON {well: volume}.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Plate</Identifier>
      <DisplayName>Plate</DisplayName>
      <Description>Plate resource name</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>VolumesJson</Identifier>
      <DisplayName>Volumes JSON</DisplayName>
      <Description>Well volumes as JSON</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>NotInitialized</Identifier>
      <Identifier>LiquidHandlingError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>GetFirmwareTrace</Identifier>
    <DisplayName>Get Firmware Trace</DisplayName>
    <Description>Return Hamilton firmware command strings the twin has sent to the simulated instrument, from an index on, as JSON list.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>SinceIndex</Identifier>
      <DisplayName>Since Index</DisplayName>
      <Description>First trace index to return (0 = all)</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>TraceJson</Identifier>
      <DisplayName>Trace JSON</DisplayName>
      <Description>List of {index, time, command, reply}</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
  </Command>
  <Property>
    <Identifier>InstrumentInfo</Identifier>
    <DisplayName>Instrument Info</DisplayName>
    <Description>Model, driver and simulator description of the twin</Description>
    <Observable>No</Observable>
    <DataType>
      <Basic>String</Basic>
    </DataType>
  </Property>
  <Property>
    <Identifier>Status</Identifier>
    <DisplayName>Status</DisplayName>
    <Description>idle, busy or error, with the current operation</Description>
    <Observable>Yes</Observable>
    <DataType>
      <Basic>String</Basic>
    </DataType>
  </Property>
  <DefinedExecutionError>
    <Identifier>NotInitialized</Identifier>
    <DisplayName>Not Initialized</DisplayName>
    <Description>Call Initialize before liquid handling.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>LiquidHandlingError</Identifier>
    <DisplayName>Liquid Handling Error</DisplayName>
    <Description>The twin refused or failed the operation (for example too little liquid, no tips, unknown resource); the message says why.</Description>
  </DefinedExecutionError>
</Feature>
